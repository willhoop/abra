node_modules/
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/
.env
*.local

# raw log archive — local 'never re-pull' insurance; rebuildable, extracted store is committed
data/*.raw-logs.jsonl

# archived raw logs + store snapshots are large local preservation; keep the small models
**/*.raw-logs.jsonl
data/archive/**/games.*.ladder.jsonl

# Python bytecode. 14 .pyc files were committed before this rule existed; they are
# machine- and version-specific build artifacts, not source.
__pycache__/
*.pyc

# MEW self-play output. Unbounded by design and regenerable from a seed, so it does not
# belong in git. The small browser sample (data/mew.js) IS committed.
# Every self-play artifact, not just the canonical filename. A regeneration written to
# data/games.selfplay.new.jsonl slipped past the exact-name rule and a 987MB file was committed by
# build/sync.sh's `git add -A`, which GitHub rejected outright ("pre-receive hook declined").
# Self-play output is REGENERABLE from a seed; it must never enter git.
data/games.selfplay*.jsonl

# THE GAME STORES ARE TRACKED COMPRESSED, NOT PLAIN.
#
# data/games.ladder.jsonl reached 84.6 MB against GitHub's HARD per-file limit of 100 MB. At the
# hourly collector's ~100 games/hour that was ~3,788 games -- about 38 hours -- from the point where
# every push fails, INCLUDING the ingest Action's own commit. gzip is the measure
# build/archive-regulation.js already applies to raw logs, and it is decisive here:
#
#     games.ladder.jsonl   84.6 MB -> 10.1 MB   (12%)
#     games.ots.jsonl      30.4 MB ->  3.2 MB   (11%)
#     games.bo3.jsonl      22.6 MB ->  2.1 MB   (9%)
#
# So git carries `<store>.jsonl.gz`, written by build/compress-stores.js, and the plain .jsonl is
# ignored. The plain file is still what the collector appends to and what every local run reads --
# engine/quality.js and engine/quality.py fall back to the .gz only when the plain file is absent,
# which is the fresh-clone case. Local workflow does not change.
#
# NOTE ON games.ots.jsonl: it was ALREADY listed here and tracked anyway, because .gitignore does not
# apply to files git is already following. It was committed before the rule was written, so the rule
# silently did nothing for 30.4 MB. All three are now `git rm --cached`ed, which is what actually
# makes an ignore rule take effect on a tracked path.
data/games.ladder.jsonl
data/games.ots.jsonl
data/games.bo3.jsonl
data/games.selfplay.raw-logs.jsonl
data/.mew-shards/

# Subagent git worktrees. These are real git repos, so `git add -A` records them as
# SUBMODULE references (mode 160000) with no .gitmodules entry — which makes the repo
# unclonable. GitHub Pages then fails at Checkout with "No url found for submodule path",
# and the site silently stops deploying while every push still reports success. Cost: 90
# minutes of a dead site and ~20 failed builds on 2026-07-25.
.claude/worktrees/

# md_to_pdf.js writes <name>.print.html as an intermediate and deletes it on the way out. One was
# swept into the repo by the auto-commit watcher (3a2514a, "auto: Sat 07/25/2026") and then showed
# up as a spurious deletion on the next PDF rebuild. It is a build temp; it is not an artifact.
docs/*.print.html

# Head-to-head experiment outputs. Large, regenerable from the seed recorded in every record,
# and not a durable store -- the ladder and bo3 archives are the things worth keeping.
data/h2h-*.jsonl
data/games.h2h*.jsonl
data/games.magtest*.jsonl
data/games.pair*.jsonl

# QUARANTINED RUNS. Corpora withdrawn as contaminated, kept on disk so a retraction can be checked
# against the actual bytes rather than against a note about them. Never committed.
# The pattern above does NOT match a subdirectory, so `git add -A` duly staged 177 MB of withdrawn
# self-play here on 2026-07-27 -- and one of those files is over GitHub's 100 MB hard limit, so the
# push would have been rejected after the commit was already made.
data/quarantine/

# Head-to-head game output, whatever it is called. The exact-prefix rule `data/games.h2h*.jsonl`
# missed `data/games.overnight-h2h.jsonl` — the same near-miss the comment at line 25 records for
# games.selfplay.new.jsonl, which put a 987 MB file in the history. A 2026-07-31 audit found 23.7 GB
# of this output in data/. Match the SUBSTRING, not the prefix.
data/games.*h2h*.jsonl
data/games.*h2h*.raw-logs.jsonl
data/.*.jsonl

# Live games recorded by engine/mag_bot.js --rollout. These are game RECORDS, not source:
# they grow without bound while the bot is up, and they are reproducible from the battles
# themselves. Kept out of the repo for the same reason data/games.*.jsonl is.
data/live-games/

# The Showdown account password for engine/mag_bot.js. One line, never committed.
data/.showdown-pass

# R4 experiment output. Regenerable from the seed in every record; NOT a durable store.
# The two runs a published number rests on are tracked and named as exceptions, so the
# rule reads the way it behaves rather than leaning on git's already-tracked carve-out.
data/games.r4*.jsonl
!data/games.r4-decided.jsonl
!data/games.r4-baseline.jsonl

# Phase-1 dump for a phase 2 that does not exist (engine/lookahead_divergence.js:5-13).
# Each row carries a full protocol log plus 49 forked deltas. Nothing cites it.
data/lookahead-divergence.jsonl

# build/omnibus.py writes <out>.html beside the PDF. Build output, same class as docs/*.print.html.
/omnibus.html

# The differential's team-pool cache (ROADMAP #87). 11 MB, derived, and rebuilt in ~14 s from the
# store on any miss — carrying it in git would add a megabyte-scale churn every time OPS appends.
# Its DIGEST travels in the artifacts that used it, which is what makes a run checkable.
data/diff-team-pool.json

# ---- FROZEN ENGINE RELEASES (2026-08-07) --------------------------------------------------------
# A release is a BYTE-COPY of 23 files, ~3.2MB each, and they are cut freely — several per session.
# 44 on disk is 122MB, and the pack had reached 321MB with no .gitignore rule at all. They are working
# state, not source: every file inside one is already tracked at its own path, so a release duplicates
# content git is holding anyway.
#
# CITED RELEASES STAY TRACKED. A stamped measurement points at a release id, and CLAUDE.md is explicit
# that it must be a COPY rather than a checksum — "verifying digests afterwards only tells you the run
# was wasted". Ignoring a directory does NOT untrack files already in the index, so the 26 releases an
# artifact or an arm table names are unaffected. When a NEW release becomes evidence for a published
# number, add it deliberately:  git add -f data/releases/<id>
data/releases/

# The frozen team pool is a LOCAL measurement pin, not repo content — the live stores it
# copies (data/games.*.jsonl) are ignored a few lines above for the same reason, and one of
# them is 104 MB, over GitHub's hard limit. FROZEN.md IS tracked: it carries the line counts
# and sha256 of both files, which is what makes the pin checkable rather than assumed.
data/team-pool-frozen/*.jsonl
