#!/bin/sh
# pre-commit — the living-docs rule, enforced instead of remembered.
#
# WHY THIS EXISTS, AND WHY IT DID NOT UNTIL 2026-08-06.
# CLAUDE.md said, for months: "No pre-commit hook enforces this, deliberately. The failure was
# normalisation, not invisibility, and a blocking hook would collide with the auto-commit timer."
# THE AUTO-COMMIT TIMER IS DEAD. 513 `auto: <date>` commits ran between 2026-07-22 and 2026-07-25,
# the last at 16:51 on the 25th, and nothing has fired since -- no scheduled task matches
# commit/push/git, .git/hooks holds only samples, and this working tree sat modified for over an hour
# on 2026-08-06 without a single unattended commit. The stated blocker no longer exists.
#
# And the rule it was protecting broke that same evening: commit f60b01c stamped "3.60.0" in its
# message and wrote no CHANGELOG entry, in the same session whose author had just quoted the rule.
# It was caught only because a test happened to be run afterwards. That is the definition of a rule
# that needs a gate rather than a reader.
#
# INSTALL (once, per clone):  git config core.hooksPath .githooks
# The hook lives in the repo so it travels; core.hooksPath is what arms it.

# NEVER FIRE MID-REBASE. CLAUDE.md documents this repository reaching a detached HEAD 43 commits into
# a 45-commit rebase. A hook that blocks a replay step turns a recoverable rebase into a wedged one,
# and the replayed commits were already reviewed when they were first made.
if [ -d "$(git rev-parse --git-dir)/rebase-merge" ] || [ -d "$(git rev-parse --git-dir)/rebase-apply" ]; then
  echo "pre-commit: rebase in progress — skipping (replayed commits were checked when first made)"
  exit 0
fi

# SCOPE. A pure artifact regeneration is not a documentation event -- data/*.json moves every time a
# generator runs, and demanding a version bump for that would train everyone to pass --no-verify,
# which is worse than no hook. Fire only when something a reader could read has changed.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
echo "$STAGED" | grep -qE '^(docs/|engine/|tests/|web/|CHANGELOG\.md|README\.md|CLAUDE\.md)' || {
  exit 0
}

# THE SPRINT CLAUSE. Will, 2026-08-10: "yes faster, lets just keep a running notes list doc that we
# can then use to update the living docs upon completion of medicham."
#
# The full living-docs pass is DEFERRED for the duration of the MEDICHAM gate sprint -- deliberately,
# by the repository owner, on the record. This clause exists so the deferral is CHECKED rather than
# merely promised: while docs/MEDICHAM-SPRINT-NOTES.md exists, a commit that touches engine/ or tests/
# must ALSO touch that file. A fix that records nothing still fails.
#
# That is the difference between this and the drift the hook was built for. The debt is deferred,
# visible and countable; it is not silent. Deleting the notes file re-arms the normal rule, which is
# what happens when the gate closes and the batch is written up.
SPRINT="docs/MEDICHAM-SPRINT-NOTES.md"
if [ -f "$SPRINT" ]; then
  if echo "$STAGED" | grep -qE '^(engine/|tests/)'; then
    echo "$STAGED" | grep -qF "$SPRINT" || {
      echo ""
      echo "  BLOCKED: MEDICHAM sprint is active and this commit records nothing."
      echo "    It touches engine/ or tests/ but not $SPRINT."
      echo "    The living-docs pass is deferred, NOT waived -- add the row, then commit."
      echo "    (Delete $SPRINT to end the sprint and re-arm the full rule.)"
      exit 1
    }
  fi
fi

echo "pre-commit: living-docs gate (~2s)"
FAILED=0

# THE RE-RUNNABILITY CLAUSE — 2026-08-12. Will: "make sure this never happens again."
#
# A release freezes the ENGINE and not the READER. Every symbol added to a caller's `need` list
# retroactively strands every release cut before that symbol existed: the snapshot still verifies,
# still holds its bytes, and silently stops being openable. It surfaced as ELEVEN scenarios reading
# `release THREW`, which reads as eleven broken mechanics and was one aged-out baseline.
#
# tests/test-artifact-rerunnable.js ratchets it, and a check that has to be REMEMBERED is the thing
# LESSONS.md exists to stop -- so it runs here. Growing a `need` list now costs a named artifact at
# the moment the cost is paid, rather than a week later.
#
# It is in the same loop as the docs gates and under the same scope guard: it only fires when
# engine/, tests/ or docs/ move, so a pure artifact regeneration still commits freely.

# THE HOOK MUST NOT LEAVE ITS OWN GATE'S OUTPUT BEHIND THE COMMIT IT JUST CLEARED -- 2026-08-23.
#
# tests/test-docs-current.js writes data/docs-currency-baseline.json on a green run when the ratchet
# has moved. Run from here, that write landed in the working tree AFTER the index was built, so the
# commit went out without it and the file sat dirty. Three commits on 2026-08-23 -- 086dd25, 4383241,
# 483f529 -- contained nothing else, each cleaning up after the one before.
#
# The bulk of that was the gate rewriting itself for no finding at all, and that is fixed in the gate
# (PROVENANCE vs RATCHET keys; 0 of the 3 diffs carried information). What remains is the case where
# the ratchet GENUINELY moved, and for that the file is a FINDING and belongs in this commit. Staging
# it is safe by construction: that write happens only on a GREEN run and is MONOTONE -- lists may only
# shrink and counts may only fall -- so it cannot smuggle in a regression.
#
# THE LIST IS NAMED, NOT SWEPT, AND THAT IS DELIBERATE. Diffing the whole tree before and after would
# be self-maintaining and would also stage whatever another agent happened to write during the two
# seconds the gates were running -- and several agents run against this repository at once. A hook
# that edits the index may only touch files it can name. The other two gates in the loop above were
# MEASURED read-only on 2026-08-23: test-roadmap-register.js contains no write at all, and
# test-artifact-rerunnable.js writes only under --stamp. If either ever writes by default, add it here.
GATE_ARTIFACTS="data/docs-currency-baseline.json"
GATE_SNAP="$(git rev-parse --git-dir)/precommit-gate-snap.$$"
: > "$GATE_SNAP"
for f in $GATE_ARTIFACTS; do
  echo "$(git hash-object "$f" 2>/dev/null || echo ABSENT) $f" >> "$GATE_SNAP"
done

for t in tests/test-docs-current.js tests/test-roadmap-register.js tests/test-artifact-rerunnable.js; do
  [ -f "$t" ] || continue
  if ! OUT=$(node "$t" 2>&1); then
    echo ""
    echo "  BLOCKED by $t"
    echo "$OUT" | grep -iE 'FAIL|undeclared|stale|untraceable' | head -12 | sed 's/^/    /'
    FAILED=1
  fi
done

# Only when the gates were GREEN. A red run does not write, and if one ever did, adopting its output
# is the "a run that found a regression must not record the regression as normal" failure.
if [ "$FAILED" -eq 0 ]; then
  while read -r WAS F_PATH; do
    NOW=$(git hash-object "$F_PATH" 2>/dev/null || echo ABSENT)
    [ "$NOW" = "$WAS" ] && continue
    if git add -- "$F_PATH" 2>/dev/null; then
      echo "  STAGED by the gate: $F_PATH -- the ratchet moved, so it is part of THIS commit."
      echo "    (it tightened; the write is green-only and monotone. git diff --cached -- $F_PATH)"
    else
      echo "  WARNING: $F_PATH was rewritten by the gate and could NOT be staged."
      echo "    It is a finding. Include it:  git add -- $F_PATH && git commit --amend --no-edit"
    fi
  done < "$GATE_SNAP"
fi
rm -f "$GATE_SNAP"

if [ "$FAILED" -ne 0 ]; then
  cat <<'MSG'

  ------------------------------------------------------------------
  The living-docs rule: a change to a model, a result or the site moves
  the white paper, the deck, the technical docs, SUMMARY, MODELS, the
  division ledger, and CHANGELOG.md -- IN THE SAME PASS, with a version
  bump. Not later, not "next commit".

  Usually one of:
    - CHANGELOG.md bumped, but a version-headed document still trails
    - a figure added that no artifact backs (generate it, cite it, or cut it)
    - a ROADMAP item cited that section 5 does not register

  DO NOT PASS --no-verify. This hook exists because the rule was broken
  by the person quoting it, in the session that quoted it. If the gate is
  wrong, fix the gate and say so in the commit; do not step around it.
  ------------------------------------------------------------------
MSG
  exit 1
fi

echo "pre-commit: green"
exit 0
