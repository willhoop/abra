#!/bin/sh
# pre-commit — the living-docs rule, enforced instead of remembered.
#
# WHY THIS EXISTS, AND WHY IT DID NOT UNTIL 2026-08-06.
# CLAUDE.md said, for months: "No pre-commit hook enforces this, deliberately. The failure was
# normalisation, not invisibility, and a blocking hook would collide with the auto-commit timer."
# THE AUTO-COMMIT TIMER IS DEAD. 513 `auto: <date>` commits ran between 2026-07-22 and 2026-07-25,
# the last at 16:51 on the 25th, and nothing has fired since -- no scheduled task matches
# commit/push/git, .git/hooks holds only samples, and this working tree sat modified for over an hour
# on 2026-08-06 without a single unattended commit. The stated blocker no longer exists.
#
# And the rule it was protecting broke that same evening: commit f60b01c stamped "3.60.0" in its
# message and wrote no CHANGELOG entry, in the same session whose author had just quoted the rule.
# It was caught only because a test happened to be run afterwards. That is the definition of a rule
# that needs a gate rather than a reader.
#
# INSTALL (once, per clone):  git config core.hooksPath .githooks
# The hook lives in the repo so it travels; core.hooksPath is what arms it.

# NEVER FIRE MID-REBASE. CLAUDE.md documents this repository reaching a detached HEAD 43 commits into
# a 45-commit rebase. A hook that blocks a replay step turns a recoverable rebase into a wedged one,
# and the replayed commits were already reviewed when they were first made.
if [ -d "$(git rev-parse --git-dir)/rebase-merge" ] || [ -d "$(git rev-parse --git-dir)/rebase-apply" ]; then
  echo "pre-commit: rebase in progress — skipping (replayed commits were checked when first made)"
  exit 0
fi

# ── A COMMIT MAY NOT ADD A CATCH BLOCK THAT HIDES THE ERROR — 2026-08-23 ────────────────────────
#
# tests/test-no-silent-failure.js found new silent catch blocks in 0.68s, was a proper ratchet, and
# was WIRED TO NOTHING. It reported into the void and the count went 67 -> 95 in four days. Writing
# one had no consequence at the moment it was written, which is the only moment that matters.
#
# WHY THIS IS SCOPED TO THE COMMIT, AND WHY IT IS NOT A NEW BASELINE. The 80 pre-existing blocks are
# real defects. Folding them into an "accepted" floor would be laundering — the failure this repo
# keeps paying for — so they stay on the books. But failing every commit on them would block work
# that has nothing to do with them, and a gate people route around with --no-verify enforces
# nothing. So the gate judges ONLY the .js files in THIS commit, against the same baseline, by the
# same catch-body hashes: a block that was already there stays already-there and cannot block you.
#
# It runs BEFORE the documentation scope guard below on purpose. That guard exits 0 for anything
# outside docs/ engine/ tests/ web/, which would let build/*.js through unexamined, and the ratchet
# scans build/ too. It stays AFTER the rebase check, so a replay still cannot be blocked.
#
# Only the top level of engine/, build/ and tests/ is matched, because that is exactly what the
# ratchet scans; a pattern wider than the scanner would silently vouch for files nobody looked at.
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(engine|build|tests)/[^/]+\.js$')
if [ -n "$STAGED_JS" ]; then
  # SAY THAT IT RAN. A gate that passes in silence is indistinguishable from a gate that skipped,
  # and "a capability that cannot prove it ran is assumed broken" is this repository's own rule.
  echo "pre-commit: silent-catch gate on $(echo "$STAGED_JS" | wc -l | tr -d ' ') staged .js file(s) (~0.7s)"
  if ! SILENT_OUT=$(node tests/test-no-silent-failure.js --only $STAGED_JS 2>&1); then
    echo ""
    echo "  BLOCKED: this commit adds code that hides an error."
    echo ""
    echo "$SILENT_OUT" | sed 's/^/    /'
    cat <<'MSG'

  ------------------------------------------------------------------
  WHAT THIS MEANS, PLAINLY. A `catch` block that says nothing means:
  something went wrong, the code carried straight on, and NOTHING will
  ever tell you. The run finishes. It prints success. It is wrong.

  That is not hypothetical here. One of these made every status
  duration in this project the fallback 3 for months. Another turned a
  failed 1.59 GB read into the words "no records read", as though the
  corpus were empty.

  HOW TO FIX IT — any ONE of these is enough:

    throw it again      catch (e) { throw e; }
    print it            catch (e) { console.error('reading X:', e.message); }
    count it            catch (e) { MEDFAILS.somethingFailed++; }

  MEDFAILS is the counter the simulator already uses (engine/
  medicham2-browser.js). A run prints it, so a swallowed failure still
  shows up as a number instead of vanishing.

  ONLY THE FILES IN THIS COMMIT ARE CHECKED. Blocks that were already
  in the file before you touched it are not your problem and did not
  cause this.

  To see everything in one of your files:
    node tests/test-no-silent-failure.js --in engine/yourfile.js

  If the silence really is correct, write the reason in a comment on
  the line, then record it ONE BLOCK at a time. A plain run prints the
  block's hash beside it, and that hash is the block's name:
    node tests/test-no-silent-failure.js --accept engine/yourfile.js <hash> "why"

  The hash is of the catch BODY, so if you later edit that block the
  acceptance stops applying and this gate asks again.

  DO NOT PASS --no-verify. If this gate is wrong, fix the gate.
  ------------------------------------------------------------------
MSG
    exit 1
  fi
fi

# ── A GENERATED BUNDLE MAY NOT BE COMMITTED STALE — 2026-09-05 ─────────────────────────────────
#
# data/abra-tags.js is data/tags.json wrapped as a browser global. It has now drifted from its
# source FIVE times. The fifth was measured tonight and was NOT cosmetic: commit 8bd853bc landed
# Parting Shot's conditional pivot into data/tags.json and did not rebuild the copy, so
# `pivotStatus.cancelsWhen` and `pivotStatus.exceptAbilities` -- both read by name in
# engine/medicham2-browser.js -- were absent from the rulebook the BROWSER engine reads, for six
# days, in HEAD.
#
# THE CHECK WAS NOT MISSING AND IT DID NOT MISS IT. engine/artifact_audit.js check G derives every
# self-declaring bundle under data/ from its own `GENERATED by <builder> from <source>` header and
# runs that builder's own --check. It was RED on this exact pair, named it, and printed the one-line
# fix. It is registered in tests/run-all.js. It went unacted-on because the only thing that runs it
# is a full suite, and the drift was already committed by then -- it is in
# docs/_reports/2026-09-04-runall-triage.md as a diagnosed row.
#
# So this adds NO new comparison. Two implementations of one fact is this repository's most
# expensive recurring failure, and there are already two here (the builder's --check and check G,
# which delegates to it). What this adds is the MOMENT: the gate now runs where the drift becomes
# permanent, which is the same argument the silent-catch clause above makes about itself.
#
# IT IS DELIBERATELY ABOVE THE SCOPE GUARD. The guard below exits 0 for a commit that stages only
# data/, and "regenerate the tags, commit the data" is EXACTLY the shape of all five instances --
# so a clause placed after it would be a check that cannot fire on the case it was written for.
#
# COST 1.6s, measured. It writes nothing: artifact_audit.js has no write call, and every builder it
# spawns returns from its --check branch before its own write. It does not need SHOWDOWN_PATH --
# without it checks D and E stand down and G still answers.
if command -v node >/dev/null 2>&1; then
  echo "pre-commit: generated-bundle gate (~1.6s) -- every data/*.js against the source it declares"
  if ! AA_OUT=$(node engine/artifact_audit.js 2>&1); then
    echo ""
    echo "  BLOCKED: a generated file in this commit's tree is not what its builder would write."
    echo ""
    echo "$AA_OUT" | grep -E '^\s*(GAP|[0-9]+ GAP)' | head -12 | sed 's/^/    /'
    cat <<'MSG'

  ------------------------------------------------------------------
  WHAT THIS MEANS, PLAINLY. A file under data/ says in its own header
  which script wrote it and from what. That script was re-run just now
  and would produce DIFFERENT bytes. So the copy is behind its source.

  That is not cosmetic here. data/abra-tags.js is the rulebook the
  BROWSER engine reads and it is frozen into every engine release. The
  node engine reads data/tags.json. When they part, the two engines are
  playing different games and nothing in either one says so.

  HOW TO FIX IT: run the builder named on the GAP line above, e.g.

    node build/build_tags_js.js

  then stage the rebuilt file with this commit. Re-cut a release if a
  measurement is going to read these bytes.

  DO NOT PASS --no-verify. If this gate is wrong, fix the gate.
  ------------------------------------------------------------------
MSG
    exit 1
  fi
else
  echo "pre-commit: node not on PATH -- generated-bundle gate SKIPPED (this is a hole, not a pass)"
fi

# SCOPE. A pure artifact regeneration is not a documentation event -- data/*.json moves every time a
# generator runs, and demanding a version bump for that would train everyone to pass --no-verify,
# which is worse than no hook. Fire only when something a reader could read has changed.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
echo "$STAGED" | grep -qE '^(docs/|engine/|tests/|web/|CHANGELOG\.md|README\.md|CLAUDE\.md)' || {
  exit 0
}

# THE SPRINT CLAUSE. Will, 2026-08-10: "yes faster, lets just keep a running notes list doc that we
# can then use to update the living docs upon completion of medicham."
#
# The full living-docs pass is DEFERRED for the duration of the MEDICHAM gate sprint -- deliberately,
# by the repository owner, on the record. This clause exists so the deferral is CHECKED rather than
# merely promised: while docs/MEDICHAM-SPRINT-NOTES.md exists, a commit that touches engine/ or tests/
# must ALSO touch that file. A fix that records nothing still fails.
#
# That is the difference between this and the drift the hook was built for. The debt is deferred,
# visible and countable; it is not silent. Deleting the notes file re-arms the normal rule, which is
# what happens when the gate closes and the batch is written up.
SPRINT="docs/MEDICHAM-SPRINT-NOTES.md"
if [ -f "$SPRINT" ]; then
  if echo "$STAGED" | grep -qE '^(engine/|tests/)'; then
    echo "$STAGED" | grep -qF "$SPRINT" || {
      echo ""
      echo "  BLOCKED: MEDICHAM sprint is active and this commit records nothing."
      echo "    It touches engine/ or tests/ but not $SPRINT."
      echo "    The living-docs pass is deferred, NOT waived -- add the row, then commit."
      echo "    (Delete $SPRINT to end the sprint and re-arm the full rule.)"
      exit 1
    }
  fi
fi

# ── EVERY CHANGE RECORDS A ROW IN docs/RUNNING-NOTES.md — WILL, 2026-09-06 ─────────────────────
#
# "we can update the documents every major release and just keep a running notes page in between
#  change the documentation rules"
#
# The full living-document set -- white paper, deck, technical docs, SUMMARY, MODELS and the PDFs --
# now moves on a MAJOR release. The notes page moves on EVERY change, and it carries the debt in
# between. The measured reason is in CLAUDE.md: docs/ENGINE.pdf alone is 28.8 MB per rebuild, .git is
# 1.1 GB, and pushes were returning HTTP 408.
#
# WITHOUT THIS CLAUSE THE RULE IS THE FIFTEENTH HANDOFF DOCUMENT. There are fourteen docs/HANDOFF-*.md
# files, each typed at the end of a session, each stale within a day, all now explicitly unmaintained.
# What separates a deferral from an abandonment is that something refuses the commit when the record
# is not written. That is this.
#
# IT IS THE SPRINT CLAUSE ABOVE, MADE PERMANENT AND WIDER. The sprint clause was a temporary bargain
# that ENDED BY DELETING ITS MARKER. This one does not end, and deleting the notes page re-arms
# nothing -- tests/test-docs-current.js clause 5a fails on a missing page.
#
# THE SCOPE IS DECIDED IN ONE PLACE. `--note-check` is engine/docs_scan.js's recordableChanges(), the
# same function tests/test-docs-current.js clause 5b applies to committed history. Two files that
# both decide one fact will disagree eventually and the disagreement will be invisible, so this
# shells out rather than carrying a second regex -- the same reason status.js shells out to
# provenance.js. Cost is one node start.
NOTES="docs/RUNNING-NOTES.md"
if command -v node >/dev/null 2>&1; then
  # SAY THAT IT RAN. A gate that passes in silence is indistinguishable from a gate that skipped.
  echo "pre-commit: running-notes gate -- every change records a row in $NOTES"
  if ! NOTE_OUT=$(node engine/docs_scan.js --note-check $STAGED 2>&1); then
    echo ""
    echo "  BLOCKED: this commit changes something a reader reads and records nothing."
    echo ""
    echo "$NOTE_OUT" | sed 's/^/    /'
    cat <<MSG

  ------------------------------------------------------------------
  WHAT THIS MEANS, PLAINLY. The living-document pass -- white paper,
  deck, technical docs, SUMMARY, MODELS, PDFs -- is DEFERRED to the
  next major release. It is not waived. $NOTES is
  where the debt is recorded, and this commit adds to the debt without
  writing it down.

  HOW TO FIX IT: add a row to the top of $NOTES.

    ## [<the version this lands as>] - <date> - one line naming what moved
    - **What changed.** ...
    - **Measured.** <figure> - \`data/<artifact>.json\`, n=<sample>.  Or: NO FIGURE.
    - **Supersedes.** ~~<old figure>~~ retracted - and DELETED from the doc that stated it.
    - **Owed to the next major.** which living document must absorb this, or none.

  A row before the release that carries it goes under [Unreleased]; the
  publish pass renames that heading to the version.

  WHAT IS OWED SO FAR:   node engine/docs_scan.js --owed

  DELETING THE NOTES PAGE DOES NOT END THIS. It is not the MEDICHAM
  sprint marker; the docs-currency gate fails on a missing page.

  DO NOT PASS --no-verify. If this gate is wrong, fix the gate.
  ------------------------------------------------------------------
MSG
    exit 1
  fi
else
  echo "pre-commit: node not on PATH -- running-notes gate SKIPPED (this is a hole, not a pass)"
fi

echo "pre-commit: living-docs gate (~2s)"
FAILED=0

# THE RE-RUNNABILITY CLAUSE — 2026-08-12. Will: "make sure this never happens again."
#
# A release freezes the ENGINE and not the READER. Every symbol added to a caller's `need` list
# retroactively strands every release cut before that symbol existed: the snapshot still verifies,
# still holds its bytes, and silently stops being openable. It surfaced as ELEVEN scenarios reading
# `release THREW`, which reads as eleven broken mechanics and was one aged-out baseline.
#
# tests/test-artifact-rerunnable.js ratchets it, and a check that has to be REMEMBERED is the thing
# LESSONS.md exists to stop -- so it runs here. Growing a `need` list now costs a named artifact at
# the moment the cost is paid, rather than a week later.
#
# It is in the same loop as the docs gates and under the same scope guard: it only fires when
# engine/, tests/ or docs/ move, so a pure artifact regeneration still commits freely.

# THE HOOK MUST NOT LEAVE ITS OWN GATE'S OUTPUT BEHIND THE COMMIT IT JUST CLEARED -- 2026-08-23.
#
# tests/test-docs-current.js writes data/docs-currency-baseline.json on a green run when the ratchet
# has moved. Run from here, that write landed in the working tree AFTER the index was built, so the
# commit went out without it and the file sat dirty. Three commits on 2026-08-23 -- 086dd25, 4383241,
# 483f529 -- contained nothing else, each cleaning up after the one before.
#
# The bulk of that was the gate rewriting itself for no finding at all, and that is fixed in the gate
# (PROVENANCE vs RATCHET keys; 0 of the 3 diffs carried information). What remains is the case where
# the ratchet GENUINELY moved, and for that the file is a FINDING and belongs in this commit. Staging
# it is safe by construction: that write happens only on a GREEN run and is MONOTONE -- lists may only
# shrink and counts may only fall -- so it cannot smuggle in a regression.
#
# THE LIST IS NAMED, NOT SWEPT, AND THAT IS DELIBERATE. Diffing the whole tree before and after would
# be self-maintaining and would also stage whatever another agent happened to write during the two
# seconds the gates were running -- and several agents run against this repository at once. A hook
# that edits the index may only touch files it can name. The other two gates in the loop above were
# MEASURED read-only on 2026-08-23: test-roadmap-register.js contains no write at all, and
# test-artifact-rerunnable.js writes only under --stamp. If either ever writes by default, add it here.
GATE_ARTIFACTS="data/docs-currency-baseline.json"
GATE_SNAP="$(git rev-parse --git-dir)/precommit-gate-snap.$$"
: > "$GATE_SNAP"
for f in $GATE_ARTIFACTS; do
  echo "$(git hash-object "$f" 2>/dev/null || echo ABSENT) $f" >> "$GATE_SNAP"
done

# HONOUR THE SCRIPT'S OWN `ABRA-HEAP: <MB>` DECLARATION, exactly as tools/lownode.cmd does.
# Added 2026-09-04. This loop called bare `node`, so test-artifact-rerunnable.js -- which audits 91
# stamped artifacts across 30 releases -- died at the default heap (exit 134) PARTWAY THROUGH and
# blocked the commit on a partial verdict that read WORSE than the truth: it had printed a STRANDED
# line and died before printing "no artifact became unre-runnable since the baseline". A gate that
# cannot finish is not a stricter gate; its answer is whatever it managed to say before it died.
# The declaration is read here rather than hard-coded so a NEW gate added to this loop inherits it.
for t in tests/test-docs-current.js tests/test-roadmap-register.js tests/test-artifact-rerunnable.js; do
  [ -f "$t" ] || continue
  HEAP=$(grep -m1 -oE 'ABRA-HEAP:[[:space:]]*[0-9]+' "$t" 2>/dev/null | grep -oE '[0-9]+')
  if [ -n "$HEAP" ]; then NODEOPT="--max-old-space-size=$HEAP"; else NODEOPT=""; fi
  if ! OUT=$(node $NODEOPT "$t" 2>&1); then
    echo ""
    echo "  BLOCKED by $t"
    echo "$OUT" | grep -iE 'FAIL|undeclared|stale|untraceable' | head -12 | sed 's/^/    /'
    FAILED=1
  fi
done

# Only when the gates were GREEN. A red run does not write, and if one ever did, adopting its output
# is the "a run that found a regression must not record the regression as normal" failure.
if [ "$FAILED" -eq 0 ]; then
  while read -r WAS F_PATH; do
    NOW=$(git hash-object "$F_PATH" 2>/dev/null || echo ABSENT)
    [ "$NOW" = "$WAS" ] && continue
    if git add -- "$F_PATH" 2>/dev/null; then
      echo "  STAGED by the gate: $F_PATH -- the ratchet moved, so it is part of THIS commit."
      echo "    (it tightened; the write is green-only and monotone. git diff --cached -- $F_PATH)"
    else
      echo "  WARNING: $F_PATH was rewritten by the gate and could NOT be staged."
      echo "    It is a finding. Include it:  git add -- $F_PATH && git commit --amend --no-edit"
    fi
  done < "$GATE_SNAP"
fi
rm -f "$GATE_SNAP"

if [ "$FAILED" -ne 0 ]; then
  cat <<'MSG'

  ------------------------------------------------------------------
  The living-docs rule, as Will restated it on 2026-09-06: a change moves
  docs/RUNNING-NOTES.md, the division ledger and CHANGELOG.md IN THE SAME
  PASS. The white paper, the deck, the technical docs, SUMMARY, MODELS and
  the PDFs move on a MAJOR release -- an X.0.0 entry -- folded in from the
  rows of the notes page. Not later, not "next commit".

  Usually one of:
    - a document still trails the last X.0.0 release (the major pass was skipped)
    - the backlog owed to the next major is over the cap: node engine/docs_scan.js --owed
    - a figure added that no artifact backs (generate it, cite it, or cut it)
    - a ROADMAP item cited that section 5 does not register

  DO NOT PASS --no-verify. This hook exists because the rule was broken
  by the person quoting it, in the session that quoted it. If the gate is
  wrong, fix the gate and say so in the commit; do not step around it.
  ------------------------------------------------------------------
MSG
  exit 1
fi

echo "pre-commit: green"
exit 0
